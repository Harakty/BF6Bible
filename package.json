{
  "name": "bf6bible",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ingest:weapons": "node scripts/ingestWeapons.mjs",
    "ingest:patch": "tsx scripts/ingestPatchNotes.mjs",
    "ingest:attachments": "tsx scripts/ingestAttachments.mjs",
    "scrape:consensus": "tsx scripts/scrapeBattlefieldMeta.mjs",
    "generate:builds": "node scripts/generateBuilds.mjs",
    "generate:solved-builds": "tsx scripts/generateSolvedBuilds.mjs",
    "diff:builds": "node scripts/diffTemplateVsSolved.mjs",
    "report:gaps": "tsx scripts/reportCalibrationGaps.mjs",
    "report:attachments": "tsx scripts/reportAttachmentCoverage.mjs",
    "report:consensus": "tsx scripts/reportConsensusCoverage.mjs",
    "refresh:data": "npm run ingest:weapons && npm run ingest:patch && npm run scrape:consensus && npm run ingest:attachments && npm run ingest:chase && npm run generate:builds && npm run generate:solved-builds",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "ingest:chase": "tsx scripts/ingestChaseBuilds.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cheerio": "^1.2.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
